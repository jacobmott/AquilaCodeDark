// The whole ship shares its hit positions. Waves cross seams between copied hull and turret meshes.
float grazing = 1 - saturate(abs(dot(normalize(NormalWS), normalize(ViewWS))));
float2 uvEdge = min(frac(UV), 1 - frac(UV)) / max(fwidth(UV), 0.0001);
float edge = 1 - smoothstep(0.25, 1.35, min(uvEdge.x, uvEdge.y));
float3 light = float3(0.035, 0.23, 0.47) * (0.006 + 0.038 * pow(grazing, 3) + 0.062 * edge);

float3 strikes[3] = {HitA, HitB, HitC};
for (int i = 0; i < 3; ++i)
{
    float age = Ages[i];
    if (age >= 1) continue;
    float d = length(PositionWS - strikes[i]) / max(Reach, 1);
    float fade = 1 - smoothstep(0.16, 1, age);
    float wave = 0.018 + age * 0.88;
    float front = exp(-72 * abs(d - wave));
    float wake = exp(-45 * abs(d - max(0, wave - 0.09)));
    float hot = exp(-140 * d * d - 6 * age);
    float spill = exp(-14 * d * d) * (1 - age);
    float3 contact = float3(0.012, 0.30, 1.0) * spill * (0.32 + 0.70 * edge + 0.45 * grazing);
    contact += float3(0.10, 0.92, 1.6) * (front + 0.17 * wake) + float3(0.86, 1.45, 1.9) * hot;
    light = max(light, contact * fade);
}
return light;
