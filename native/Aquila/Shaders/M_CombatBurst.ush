// Additive light, drawn on a camera-facing plane at a real contact or a ship's last position.
float2 p = (UV - 0.5) * 2;
float r = length(p);
if (r >= 1) return 0;
float age = saturate(Settings.x);
float style = Settings.y;
float seed = Settings.z;
float fade = 1 - smoothstep(0.18, 1, age);
if (style < 2.5)
{
    float core = exp(-r * r * 32) * exp(-4 * age);
    float halo = exp(-r * r * 8);
    float ring = exp(-40 * abs(r - (0.14 + age * 0.66)));
    float2 axis = float2(cos(seed), sin(seed));
    float2 aligned = float2(dot(p, axis), dot(p, float2(-axis.y, axis.x)));
    float streak = exp(-abs(aligned.y) * 62 - abs(aligned.x) * 4.8);
    float3 color = style < 0.5 ? float3(0.08, 0.85, 2.4)
                              : (style < 1.5 ? float3(1.8, 0.62, 0.08) : float3(2.2, 0.23, 0.028));
    float shape = style < 0.5 ? 0.24 * halo + 0.38 * ring + 0.50 * streak
               : (style < 1.5 ? 0.18 * halo + 1.15 * streak : 0.58 * halo + 0.35 * streak);
    return fade * (float3(2.2, 1.7, 1.1) * core + color * shape) * (1 - smoothstep(0.78, 1, r));
}

struct BurstNoise
{
    float hash(float2 v)
    {
        float3 q = frac(float3(v.xyx) * 0.1031);
        q += dot(q, q.yzx + 33.33);
        return frac((q.x + q.y) * q.z);
    }
    float value(float2 v)
    {
        float2 i = floor(v), f = frac(v);
        f = f * f * (3 - 2 * f);
        return lerp(lerp(hash(i), hash(i + float2(1, 0)), f.x),
                    lerp(hash(i + float2(0, 1)), hash(i + 1), f.x), f.y);
    }
    float cloud(float2 v)
    {
        return 0.54 * value(v) + 0.27 * value(v * 2.07 + 7.1)
             + 0.13 * value(v * 4.23 - 9.7) + 0.06 * value(v * 8.61);
    }
};
BurstNoise noise;
float radius = 0.09 + 0.57 * (1 - exp(-5 * age));
float2 v = p / radius;
float2 q = v * 2.5 + float2(seed, -seed);
float2 warp = float2(noise.cloud(q + float2(0, -1.8) * age),
                     noise.cloud(q.yx + float2(4.8, 1.1) + age));
float billow = noise.cloud(v * 5.4 + 2.6 * warp + seed - age * 1.5);
float fine = noise.value(v * 23 + 4 * warp);
float depth = 1 - length(v) + 0.7 * (warp.x - 0.5) + 0.28 * (billow - 0.5);
float gas = smoothstep(-0.06, 0.17, depth);
float heat = saturate(0.28 + depth * 0.19 + (billow - 0.47) * 1.85 + fine * 0.11
                      + 0.32 * exp(-10 * age) - 0.30 * age);
float3 fire = lerp(float3(0.045,0.003,0.002), float3(0.91,0.082,0.012), smoothstep(0.06,0.39,heat));
fire = lerp(fire, float3(1.85,0.53,0.052), smoothstep(0.32,0.68,heat));
fire = lerp(fire, float3(2.8,1.65,0.68), smoothstep(0.65,0.91,heat));
float shock = exp(-82 * abs(r - (0.10 + 0.88 * sqrt(age)))) * (1 - smoothstep(0.10,0.53,age));
float halo = exp(-9 * r * r) * exp(-6 * age);
bool mainBlast = style < 3.5;
float3 blast = gas * fire * (mainBlast ? 0.92 : 0.38);
blast += mainBlast ? (float3(0.75,0.48,0.20) * shock + float3(0.7,0.18,0.03) * halo) : 0;
return blast * (1 - smoothstep(0.34, 1, age));
